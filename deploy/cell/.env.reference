# Variables the cell overlay (docker-compose.cell.yaml) requires: names only, never values.
# One name per line. Keep in sync with the ${VAR:?...} entries in the overlay.
POSTGRES_PASSWORD
REDIS_PASSWORD
MINIO_ROOT_USER
MINIO_ROOT_PASSWORD
TELEPHONY_WS_TOKEN_SECRET
DOGRAH_DEVOPS_SECRET
OSS_JWT_SECRET
