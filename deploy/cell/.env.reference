# Variables the cell overlay (docker-compose.cell.yaml) requires: names only, never values.
# Values must be URL-safe ([A-Za-z0-9_-], e.g. hex): POSTGRES_PASSWORD and REDIS_PASSWORD are pasted raw
# into URLs and the redis command line.
# One name per line. Every variable that `docker compose -f docker-compose.yaml -f docker-compose.cell.yaml config` requires (base + overlay).
POSTGRES_PASSWORD
REDIS_PASSWORD
MINIO_ROOT_USER
MINIO_ROOT_PASSWORD
TELEPHONY_WS_TOKEN_SECRET
DOGRAH_DEVOPS_SECRET
TURN_SECRET
# Credentials-at-rest key list, comma-separated 'id=base64(32 bytes)', active key first (from the cell Secrets Manager).
CREDENTIALS_MASTER_KEY
OSS_JWT_SECRET
S3_BUCKET
S3_REGION
# The fork's api image, pinned by digest (repo@sha256:...): every api-image role (api, call, arq, coordinators) runs it.
CELL_API_IMAGE
# Memory cap of the call role as a compose size (e.g. 2g); it is the OOM victim before Postgres and Redis.
CALL_MEM_LIMIT
# Longest call of the cell, in seconds (the one duration a cell writes), and the call role's stop grace in seconds
# rendered from it. Write both with `python -m scripts.xpand.render_durations` (api/services/runtime/durations.py).
CELL_CALL_DURATION_CEILING_S
CELL_STOP_GRACE_S
# The call role's drain window and initial delay, in seconds, from the same render: without them the drain script
# would stop waiting at its built-in default whatever the ceiling.
DRAIN_MAX_WAIT
DRAIN_INITIAL_DELAY
