# Variables the cell overlay (docker-compose.cell.yaml) requires: names only, never values.
# Values must be URL-safe ([A-Za-z0-9_-], e.g. hex): POSTGRES_PASSWORD and REDIS_PASSWORD are pasted raw
# into URLs and the redis command line.
# One name per line. Every variable that `docker compose -f docker-compose.yaml -f docker-compose.cell.yaml config` requires (base + overlay).
POSTGRES_PASSWORD
REDIS_PASSWORD
MINIO_ROOT_USER
MINIO_ROOT_PASSWORD
TELEPHONY_WS_TOKEN_SECRET
DOGRAH_DEVOPS_SECRET
TURN_SECRET
OSS_JWT_SECRET
S3_BUCKET
S3_REGION
